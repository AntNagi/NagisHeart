# 本文件是模板。真实值写进 .env（已 gitignore），永不提交。
# 注意：BYOK 模式下，使用者的 key 由客户端随请求透传，不配在这里。
# 这里只配开发期自测用的 key。

# 开发自测用的国产模型 key（D8 / NRH-20260820-019）
NAGI_DEV_LLM_KEY=

# OpenAI-compatible 国产模型 Provider（未填写时使用 local-provider 开发桩）
NAGI_LLM_ENDPOINT=
NAGI_LLM_MODEL=

# aux 能力位：场景分类 / 记忆抽取 / OOC 打分，便宜优先（V4 §10）。
# 不配则跳过记忆抽取——不会拿 main 模型顶替（贵 5–10 倍且未经标定）。
NAGI_LLM_MODEL_AUX=
NAGI_LLM_TIMEOUT_MS=60000

# 服务端监听端口
PORT=8787

# 同步凭证派生用的服务端密钥（HMAC，见 V4 §7.4）。生产必须换成随机高熵值。
NAGI_SYNC_HMAC_SECRET=change-me-in-production
