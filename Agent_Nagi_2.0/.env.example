# 本文件是模板。真实值写进 .env（已 gitignore），永不提交。
# 注意：BYOK 模式下，使用者的 key 由客户端随请求透传，不配在这里。
# 这里只配开发期自测用的 key。

# 开发自测用的国产模型 key（D8 / NRH-20260820-019）
NAGI_DEV_LLM_KEY=

# OpenAI-compatible 国产模型 Provider（未填写时使用 local-provider 开发桩）
# ── 厂商二选一 ────────────────────────────────────────────────
# A) 火山方舟（豆包）—— 首发选型，见 NRH-20260820-019
# NAGI_LLM_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/chat/completions
# NAGI_LLM_MODEL=doubao-seed-character-260628
# NAGI_LLM_MODEL_AUX=doubao-seed-2-0-mini-260215
#
# B) Gemini 免费额度 —— **仅开发调试用**，不改变首发选型
#    key 免费领：https://aistudio.google.com/apikey
#    ⚠ 国内需代理。Node 的 fetch 不读 HTTP_PROXY，脚本已加 --use-env-proxy
# NAGI_LLM_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# NAGI_LLM_MODEL=gemini-2.5-flash
# NAGI_LLM_MODEL_AUX=gemini-2.5-flash-lite
NAGI_LLM_ENDPOINT=
NAGI_LLM_MODEL=

# aux 能力位：场景分类 / 记忆抽取 / OOC 打分，便宜优先（V4 §10）。
# 不配则跳过记忆抽取——不会拿 main 模型顶替（贵 5–10 倍且未经标定）。
NAGI_LLM_MODEL_AUX=
# 记忆与关系的持久化库。**不配则重启即丢全部对话记忆**（见 OPEN_QUESTIONS F24）。
# var/ 已 gitignore。单测不加载 .env，故继续走内存、彼此隔离。
NAGI_DOMAIN_DB=var/nagi.sqlite

NAGI_LLM_TIMEOUT_MS=60000

# 服务端监听端口
PORT=8787

# 同步凭证派生用的服务端密钥（HMAC，见 V4 §7.4）。生产必须换成随机高熵值。
NAGI_SYNC_HMAC_SECRET=change-me-in-production
