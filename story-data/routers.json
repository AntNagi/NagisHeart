{
  "m_igate": {
    "description": "第五部深/浅线分流",
    "rules": [
      {
        "condition": "control >= 2 || distance >= 3",
        "target": "m_shallow",
        "label": "浅线：客气的距离",
        "sideEffects": [
          {
            "var": "cohabitShallow",
            "op": "set",
            "val": true
          }
        ]
      }
    ],
    "fallback": "e_intimate_cohabit",
    "fallbackSideEffects": [
      {
        "var": "mDeep",
        "op": "set",
        "val": true
      }
    ]
  },
  "route_mj_hidden": {
    "description": "第六部M/J隐藏分流",
    "rules": [
      {
        "condition": "mj === 'J'",
        "target": "e_agency_launch",
        "label": "J线入口",
        "sideEffects": [
          {
            "var": "mj",
            "op": "set",
            "val": "J"
          }
        ]
      }
    ],
    "fallback": "e_agency_launch",
    "fallbackSideEffects": [
      {
        "var": "mj",
        "op": "set",
        "val": "M"
      }
    ],
    "note": "M/J由club_media关键选择写入；此路由统一进入e_agency_launch，byRoute根据mj值决定后续链路"
  },
  "route_love_hidden": {
    "description": "第七部爱/习惯隐藏判定",
    "rules": [
      {
        "condition": "mj === 'M'",
        "target": "p8_route",
        "label": "TRUE/GOOD资格池",
        "sideEffects": [
          {
            "var": "route",
            "op": "set",
            "val": "trueGoodPool"
          }
        ]
      },
      {
        "condition": "mj === 'J'",
        "target": "p8_route",
        "label": "NORMAL/BAD资格池",
        "sideEffects": [
          {
            "var": "route",
            "op": "set",
            "val": "normalBadPool"
          }
        ]
      }
    ],
    "fallback": "p8_route",
    "fallbackSideEffects": [
      {
        "var": "route",
        "op": "set",
        "val": "trueGoodPool"
      }
    ],
    "note": "M严格进入TRUE/GOOD池，J严格进入NORMAL/BAD池；数值只影响池内结局，不得跨池"
  },
  "ending_resolver": {
    "description": "结局判定路由器，根据GameState评估endings.json的judgement规则",
    "note": "按bad→true→good→normal优先级匹配，先进入对应 Epilogue 终章；终章播放完成后再触发 Ending Card。",
    "rules": [
      {
        "condition": "mj === 'J' && path === 'bad' && finalChoice === 'coronation'",
        "target": "ep_bad",
        "label": "BAD END"
      },
      {
        "condition": "mj === 'M' && path === 'dream' && finalChoice === 'witness' && antCompress === false && witnessFlag === true && personalHonor === true && nagiNameIndependent === true && control <= 2 && distance <= 3",
        "target": "ep_true",
        "label": "TRUE END"
      },
      {
        "condition": "mj === 'M' && path === 'dream'",
        "target": "ep_good",
        "label": "GOOD END"
      },
      {
        "condition": "mj === 'J'",
        "target": "ep_normal",
        "label": "NORMAL END（J池内默认）"
      }
    ],
    "fallback": "ep_good"
  }
}
