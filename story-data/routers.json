{
  "m_igate": {
    "description": "第五部深/浅线分流",
    "rules": [
      {
        "condition": "control >= 2 || distance >= 3",
        "target": "m_shallow",
        "label": "浅线：客气的距离",
        "sideEffects": [
          {
            "var": "cohabitShallow",
            "op": "set",
            "val": true
          }
        ]
      }
    ],
    "fallback": "e_intimate_cohabit",
    "fallbackSideEffects": [
      {
        "var": "mDeep",
        "op": "set",
        "val": true
      }
    ]
  },
  "route_mj_hidden": {
    "description": "第六部M/J隐藏分流：club_media关键选择 + 长期管理倾向共同决定",
    "rules": [
      {
        "condition": "mjChoice === 'J' || mj === 'J'",
        "target": "e_agency_launch",
        "label": "J线入口（关键选择）",
        "sideEffects": [
          {
            "var": "mj",
            "op": "set",
            "val": "J"
          }
        ]
      },
      {
        "condition": "control >= 5 || (control >= 3 && distance >= 6)",
        "target": "e_agency_launch",
        "label": "J线入口（长期管理倾向翻盘）",
        "sideEffects": [
          {
            "var": "mj",
            "op": "set",
            "val": "J"
          },
          {
            "var": "mjByTendency",
            "op": "set",
            "val": true
          }
        ]
      }
    ],
    "fallback": "e_agency_launch",
    "fallbackSideEffects": [
      {
        "var": "mj",
        "op": "set",
        "val": "M"
      }
    ],
    "note": "规则1：club_media选J项直接进J（mj === 'J' 分支仅为兼容旧存档）。规则2：即使选了M项，若长期管理倾向已高（control>=5，或control>=3且distance>=6）仍判入J，并置mjByTendency标记——一个手势改不掉已经形成的相处方式。阈值可直接调这三个数字。distance有强制下限约3（e_intimate强制+2、m_shallow最少+1），故不单独用低distance作理解型信号。统一进入e_agency_launch，byRoute根据mj值决定后续链路"
  },
  "route_love_hidden": {
    "description": "第七部爱/习惯隐藏判定",
    "rules": [
      {
        "condition": "mj === 'M'",
        "target": "p8_route",
        "label": "TRUE/GOOD资格池",
        "sideEffects": [
          {
            "var": "route",
            "op": "set",
            "val": "trueGoodPool"
          }
        ]
      },
      {
        "condition": "mj === 'J'",
        "target": "p8_route",
        "label": "NORMAL/BAD资格池",
        "sideEffects": [
          {
            "var": "route",
            "op": "set",
            "val": "normalBadPool"
          }
        ]
      }
    ],
    "fallback": "p8_route",
    "fallbackSideEffects": [
      {
        "var": "route",
        "op": "set",
        "val": "trueGoodPool"
      }
    ],
    "note": "M严格进入TRUE/GOOD池，J严格进入NORMAL/BAD池；数值只影响池内结局，不得跨池"
  },
  "ending_resolver": {
    "description": "结局判定路由器，根据GameState评估endings.json的judgement规则",
    "note": "按bad→true→good→normal优先级匹配，先进入对应 Epilogue 终章；终章播放完成后再触发 Ending Card。",
    "rules": [
      {
        "condition": "mj === 'J' && path === 'bad' && finalChoice === 'coronation'",
        "target": "ep_bad",
        "label": "BAD END"
      },
      {
        "condition": "mj === 'M' && path === 'dream' && finalChoice === 'witness' && antCompress === false && witnessFlag === true && personalHonor === true && nagiNameIndependent === true && control <= 2 && distance <= 3",
        "target": "ep_true",
        "label": "TRUE END"
      },
      {
        "condition": "mj === 'M' && path === 'dream'",
        "target": "ep_good",
        "label": "GOOD END"
      },
      {
        "condition": "mj === 'J'",
        "target": "ep_normal",
        "label": "NORMAL END（J池内默认）"
      }
    ],
    "fallback": "ep_good"
  }
}
